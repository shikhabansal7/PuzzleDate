{
  "manifest_version": 3,
  "name": "Puzzle Date Game Reset",
  "version": "1.0.7",
  "description": "Embeds Puzzle Date games, resets supported progress, and blocks common ads and trackers inside Puzzle Date.",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "puzzle_date_game_frames",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://shikhabansal7.github.io/PuzzleDate/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
